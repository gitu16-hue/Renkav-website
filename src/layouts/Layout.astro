---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const navigation = [
  ['Home', '/'],
  ['About', '/about'],
  ['Ventures', '/ventures'],
  ['Leadership', '/leadership'],
  ['Contact', '/contact'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a1e2e" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/share.svg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href="/" aria-label="RENKAV home">
          <svg
            width="28"
            height="30"
            viewBox="0 0 28 30"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M2 28V2h12c7 0 12 8 6 13l-8 6M12 16l12 12M2 20l12-8"
              stroke="currentColor"
              stroke-width="3.5"
            />
          </svg>
          <span>
            RENKAV<span class="wordmark-dot">·</span>
          </span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map(([label, href]) => (
            <a href={href} aria-current={path === href ? 'page' : undefined}>
              {label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <button
            class="sound-toggle"
            type="button"
            data-sound-toggle
            aria-label="Mute click sounds"
            aria-pressed="true"
          >
            <span class="sound-bars" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
              <i></i>
            </span>
            <span data-sound-label>Sound on</span>
          </button>
          <a class="button button-small button-ink header-cta" href="/contact">
            Get in touch
            <Icon name="diagonal" size={16} />
          </a>
          <button
            class="menu-toggle"
            aria-controls="mobile-nav"
            aria-expanded="false"
            type="button"
          >
            <span data-menu-label>Menu</span>
            <span class="menu-lines" aria-hidden="true">
              <i></i>
              <i></i>
            </span>
          </button>
        </div>
      </div>
      <nav
        class="mobile-nav"
        id="mobile-nav"
        aria-label="Mobile navigation"
        hidden
      >
        {navigation.map(([label, href], i) => (
          <a href={href} aria-current={path === href ? 'page' : undefined}>
            <span class="mono">0{i + 1}</span>
            {label}
            <Icon name="diagonal" />
          </a>
        ))}
      </nav>
    </header>
    <div class="scroll-progress" aria-hidden="true"></div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-main">
        <div>
          <a href="/" class="wordmark footer-wordmark">
            RENKAV<span class="wordmark-dot">·</span>
          </a>
          <p>Make the Next Matter.</p>
          <a class="footer-email" href="mailto:gitanshu@renkav.online">
            gitanshu@renkav.online
            <Icon name="diagonal" size={16} />
          </a>
        </div>
        <div class="footer-links">
          <span class="eyebrow">EXPLORE</span>
          <nav aria-label="Footer navigation">
            {navigation.map(([label, href]) => (
              <a href={href}>{label}</a>
            ))}
          </nav>
        </div>
        <div class="footer-note">
          <span class="tiny-dot"></span>
          <span>
            Building from India.
            <br />
            Thinking beyond borders.
          </span>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} RENKAV Technologies</span>
        <span>Thoughtfully built. Intentionally human.</span>
        <a href="#main" class="back-top">
          Back to top <span aria-hidden="true">↑</span>
        </a>
      </div>
    </footer>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
