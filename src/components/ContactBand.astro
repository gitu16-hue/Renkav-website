---
import Icon from './Icon.astro';
interface Props {
  title?: string;
  text?: string;
  label?: string;
}
const {
  title = 'Tell us what you’d like AI to help with.',
  text = 'We’d like to hear from people with a real workflow in mind and teams interested in collaborating.',
  label = 'Get in touch',
} = Astro.props;
---

<section class="contact-band">
  <div class="container contact-band-inner" data-reveal>
    <div>
      <span class="eyebrow">LET’S BUILD WHAT’S NEXT</span>
      <h2>{title}</h2>
      {text && <p>{text}</p>}
    </div>
    <a class="button button-ink" href="/contact">
      {label}
      <Icon name="diagonal" />
    </a>
  </div>
</section>
