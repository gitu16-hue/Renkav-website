---
import Icon from './Icon.astro';
---

<section
  class="continuity-section dark-section"
  data-continuity
  aria-labelledby="continuity-heading"
>
  <div class="continuity-sticky">
    <div class="container continuity-layout">
      <div class="continuity-copy">
        <span class="eyebrow">THE IDEA BEHIND ELEVEN</span>
        <h2 id="continuity-heading">
          Different layers.
          <br />
          <span class="mint serif-accent">One continuous thread.</span>
        </h2>
        <ol class="continuity-chapters">
          <li data-chapter="0" class="is-active">
            <span class="chapter-number">01</span>
            <div>
              <h3>Your context.</h3>
              <p>The notes and decisions you choose to keep.</p>
            </div>
          </li>
          <li data-chapter="1">
            <span class="chapter-number">02</span>
            <div>
              <h3>The right intelligence.</h3>
              <p>Different models. A shared understanding.</p>
            </div>
          </li>
          <li data-chapter="2">
            <span class="chapter-number">03</span>
            <div>
              <h3>Your final say.</h3>
              <p>Every important action comes back to you.</p>
            </div>
          </li>
        </ol>
        <div class="continuity-scroll mono">
          <span aria-hidden="true">↓</span> SCROLL TO BRING IT TOGETHER
        </div>
      </div>
      <div class="continuity-visual" aria-hidden="true">
        <div class="scene-halo"></div>
        <div class="layer-assembly" data-assembly>
          <div class="system-platform">
            <span>ELEVEN</span>
            <small>A CONTINUOUS THREAD</small>
          </div>
          <div class="system-layer context-layer" data-layer="0">
            <div class="layer-top">
              <Icon name="context" />
              <span>CONTEXT</span>
              <small>01</small>
            </div>
            <div class="layer-rule"></div>
            <strong>Pick up where you left off.</strong>
            <div class="context-lines">
              <i></i>
              <i></i>
              <i></i>
            </div>
            <div class="layer-bottom">
              <span class="tiny-dot"></span> APPROVED NOTES & DECISIONS
            </div>
          </div>
          <div class="system-layer intelligence-layer" data-layer="1">
            <div class="layer-top">
              <Icon name="models" />
              <span>INTELLIGENCE</span>
              <small>02</small>
            </div>
            <div class="model-nodes">
              <i></i>
              <i></i>
              <i></i>
              <span class="model-connection"></span>
            </div>
            <strong>The right model. The same thread.</strong>
            <div class="layer-bottom">CONNECTED BY CONTEXT</div>
          </div>
          <div class="system-layer control-layer" data-layer="2">
            <div class="layer-top">
              <Icon name="control" />
              <span>YOUR CONTROL</span>
              <small>03</small>
            </div>
            <div class="approval-mark">
              <Icon name="check" size={32} />
            </div>
            <strong>Ready for your review.</strong>
            <div class="layer-bottom">YOU DECIDE WHAT HAPPENS NEXT</div>
          </div>
        </div>
        <div class="scene-axis mono">
          <span>CONTEXT</span>
          <span>INTELLIGENCE</span>
          <span>CONTROL</span>
        </div>
      </div>
      <div class="continuity-bottom">
        <span>Illustrative concept · In development</span>
        <div class="continuity-track">
          <span data-scene-progress></span>
        </div>
        <span class="mono" data-scene-count>
          01 / 03
        </span>
      </div>
    </div>
  </div>
</section>
