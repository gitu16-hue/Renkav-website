---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class:list={['orbital-art', { compact }]} data-orbit>
  <div class="orbit-grid" aria-hidden="true"></div>
  <div class="orbit-fallback" aria-hidden="true">
    <i></i>
    <i></i>
    <i></i>
    <b></b>
  </div>
  <canvas aria-hidden="true"></canvas>
  <div class="orbit-coordinate orbit-coordinate-top" aria-hidden="true">
    <span>R / 001</span>
    <span>CONNECTED BY CONTEXT</span>
  </div>
  <div class="orbit-label" aria-hidden="true">
    <span class="tiny-dot"></span> A CONTINUOUS THREAD
  </div>
  <button
    class="motion-toggle"
    type="button"
    aria-label="Pause 3D motion"
    aria-pressed="false"
    data-motion-toggle
  >
    <span class="pause-icon" aria-hidden="true">
      Ⅱ
    </span>
    <span data-motion-label>Pause motion</span>
  </button>
</div>
