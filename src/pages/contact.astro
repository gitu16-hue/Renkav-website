---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Contact | RENKAV Technologies"
  description="Contact RENKAV Technologies about ELEVEN, partnerships, research or general business inquiries."
>
  <section class="masthead contact-masthead dark-section">
    <div class="container">
      <span class="eyebrow entry">CONTACT RENKAV</span>
      <h1 class="entry entry-1">
        Good things start
        <br />
        <span class="mint serif-accent">with a conversation.</span>
      </h1>
      <p class="entry entry-2">
        Let’s talk about ELEVEN, a potential partnership,
        <br class="desktop-break" /> or a general business inquiry.
      </p>
    </div>
  </section>
  <section class="section contact-section">
    <div class="container contact-grid">
      <div class="contact-details">
        <span class="eyebrow">A DIRECT LINE</span>
        <h2>
          Let’s talk<span class="teal">.</span>
        </h2>
        <a href="mailto:gitanshu@renkav.online" class="contact-email">
          gitanshu@renkav.online
          <Icon name="diagonal" />
        </a>
        <div class="email-actions">
          <a class="text-link" href="mailto:gitanshu@renkav.online">
            Email Gitanshu
            <Icon name="mail" size={17} />
          </a>
          <button class="copy-email" type="button" data-copy-email>
            <Icon name="copy" size={16} />
            <span>Copy email</span>
          </button>
        </div>
        <p class="copy-feedback" role="status" data-copy-status></p>
        <div class="inquiry-prompts">
          <h3>What to include</h3>
          <article>
            <span class="mono">01</span>
            <div>
              <h4>Product inquiry</h4>
              <p>
                Tell us what you’re trying to accomplish, how you do it today,
                and what gets in the way.
              </p>
            </div>
          </article>
          <article>
            <span class="mono">02</span>
            <div>
              <h4>Partnership or research</h4>
              <p>
                Tell us who you are and what you’d like to explore together.
              </p>
            </div>
          </article>
          <article>
            <span class="mono">03</span>
            <div>
              <h4>Investor or incubator inquiry</h4>
              <p>
                Share your organization and the kind of conversation you have in
                mind.
              </p>
            </div>
          </article>
        </div>
      </div>
      <div class="contact-form-panel">
        <span class="eyebrow">PUT YOUR THOUGHTS TOGETHER</span>
        <h2>Start a conversation.</h2>
        <p>
          This opens a draft in your email app. Nothing is submitted through
          this website.
        </p>
        <noscript>
          <p>
            Email us directly at{' '}
            <a href="mailto:gitanshu@renkav.online">gitanshu@renkav.online</a>.
          </p>
        </noscript>
        <form id="contact-form" novalidate hidden>
          <div class="form-row">
            <div class="form-field">
              <label for="name">Name</label>
              <input
                id="name"
                name="name"
                autocomplete="name"
                placeholder="Your name"
                required
                maxlength="80"
                aria-describedby="name-error"
              />
              <span class="field-error" id="name-error"></span>
            </div>
            <div class="form-field">
              <label for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="you@company.com"
                required
                maxlength="120"
                aria-describedby="email-error"
              />
              <span class="field-error" id="email-error"></span>
            </div>
          </div>
          <div class="form-field">
            <label for="inquiry">Inquiry type</label>
            <select id="inquiry" name="inquiry">
              <option>General inquiry</option>
              <option>ELEVEN</option>
              <option>Partnership or research</option>
              <option>Investor or incubator inquiry</option>
            </select>
          </div>
          <div class="form-field">
            <label for="message">What do you have in mind?</label>
            <textarea
              id="message"
              name="message"
              placeholder="Tell us a little about your idea or workflow…"
              rows="5"
              maxlength="1000"
              required
              aria-describedby="message-error message-hint"
            ></textarea>
            <div class="message-meta">
              <span id="message-hint">
                Please leave out sensitive information.
              </span>
              <span data-character-count>0 / 1,000</span>
            </div>
            <span class="field-error" id="message-error"></span>
          </div>
          <button type="submit" class="button button-ink">
            Open email draft
            <Icon name="diagonal" />
          </button>
          <p class="form-help">
            Please don’t include passwords, confidential files or sensitive
            customer information.
          </p>
          <div class="form-result" hidden role="status" tabindex="-1">
            <Icon name="mail" />
            <p>
              Your email draft is ready to open. If your email app doesn’t open,
              copy{' '}
              <a href="mailto:gitanshu@renkav.online">gitanshu@renkav.online</a>{' '}
              and email us directly. Nothing has been sent through this website.
            </p>
            <a
              data-draft-link
              class="text-link"
              href="mailto:gitanshu@renkav.online"
            >
              Open the draft again
              <Icon name="diagonal" size={15} />
            </a>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>
