---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Page not found | RENKAV Technologies"
  description="The page you’re looking for may have moved or doesn’t exist."
>
  <section class="not-found dark-section">
    <div class="container">
      <span class="eyebrow">A THREAD OUT OF PLACE / 404</span>
      <h1>
        Page <span class="serif-accent mint">not found.</span>
      </h1>
      <p>The page you’re looking for may have moved or doesn’t exist.</p>
      <div class="button-row">
        <a href="/" class="button button-mint">
          Back to RENKAV
          <Icon />
        </a>
        <a href="/ventures" class="text-link light-link">
          Explore ELEVEN
          <Icon name="diagonal" />
        </a>
      </div>
    </div>
  </section>
</Layout>
