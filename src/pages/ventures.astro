---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import OrbitalArt from '../components/OrbitalArt.astro';
import ContactBand from '../components/ContactBand.astro';
const priorities = [
  ['voice', 'Voice and text.', 'Speak naturally or type when convenient.'],
  [
    'context',
    'Project continuity.',
    'Resume a plan using approved context and track decisions and open tasks.',
  ],
  [
    'models',
    'Model choice.',
    'Use suitable AI models without restarting the project. Some tasks may eventually run locally where supported.',
  ],
  [
    'control',
    'Approved actions.',
    'Plan, draft and eventually use supported tools within the permissions you set.',
  ],
  [
    'spark',
    'Specialist assistance.',
    'Explore limited AI specialists that return findings for review.',
  ],
];
const faqs = [
  [
    'Can I use ELEVEN today?',
    'ELEVEN is in development. We’re not announcing a public download, pricing or a launch date on this site.',
  ],
  [
    'Will it act without asking?',
    'The design requires appropriate approval for consequential actions.',
  ],
  [
    'Can I use it offline?',
    'We’re exploring local operation for supported tasks. Full offline operation is not a current promise.',
  ],
  [
    'Can I discuss a pilot?',
    'Tell us what you’d like ELEVEN to help with. An inquiry does not register you for a pilot or guarantee access.',
  ],
];
---

<Layout
  title="ELEVEN | RENKAV Technologies"
  description="Explore ELEVEN, RENKAV’s AI assistant prototype, and the workflows we’re designing it to support."
>
  <section class="venture-hero dark-section">
    <div class="container venture-hero-grid">
      <div>
        <span class="status-badge entry">
          <span class="tiny-dot"></span> OUR FIRST PROJECT · PROTOTYPE IN
          DEVELOPMENT
        </span>
        <h1 class="entry entry-1">
          ELEVEN<span class="mint">.</span>
        </h1>
        <h2 class="entry entry-2">
          One assistant for
          <br />
          <span class="serif-accent mint">work that continues.</span>
        </h2>
        <p class="entry entry-3">
          ELEVEN is a prototype for what we call an Intelligence Operating
          System. It’s an AI layer designed to connect conversations, project
          context and approved tools.
        </p>
        <div class="venture-actions entry entry-3">
          <a href="/contact" class="button button-mint">
            Discuss a use case
            <Icon name="diagonal" />
          </a>
          <span class="small-note">
            Not a replacement for Windows
            <br />
            or your existing operating system.
          </span>
        </div>
      </div>
      <OrbitalArt compact />
    </div>
  </section>
  <section class="section workflow-section">
    <div class="container">
      <div class="section-heading" data-reveal>
        <span class="eyebrow">A DAY IN THE LIFE · AN ILLUSTRATION</span>
        <div>
          <h2>
            Yesterday’s context.
            <br />
            <span class="serif-accent">Today’s next step.</span>
          </h2>
          <p>
            Here’s the kind of workflow
            <br />
            we’re designing ELEVEN to support.
          </p>
        </div>
      </div>
      <div class="workflow-demo" data-reveal>
        <div class="workflow-prompt">
          <span class="prompt-symbol" aria-hidden="true">
            <Icon name="spark" size={28} />
          </span>
          <blockquote>
            “Pick up yesterday’s partnership proposal. Check my approved notes,
            tell me what’s missing, and draft a follow-up.”
          </blockquote>
          <span class="mono">YOU → ELEVEN</span>
        </div>
        <div class="workflow-steps">
          <article>
            <span class="step-number">01</span>
            <Icon name="context" />
            <h3>Resume context</h3>
            <p>
              Start with the notes you allow. Flag anything that can’t be
              verified.
            </p>
            <span class="step-label">YOUR APPROVED CONTEXT</span>
          </article>
          <article>
            <span class="step-number">02</span>
            <Icon name="spark" />
            <h3>Prepare a draft</h3>
            <p>
              Bring the next step into focus. Prepare a follow-up for your
              review.
            </p>
            <span class="step-label">A DRAFT, READY TO REVIEW</span>
          </article>
          <article>
            <span class="step-number">03</span>
            <Icon name="control" />
            <h3>Review before sending</h3>
            <p>
              You make the decision. An email would not be sent without the
              required approval.
            </p>
            <span class="step-label">THE FINAL SAY IS YOURS</span>
          </article>
        </div>
      </div>
      <p class="workflow-caveat">
        <span class="tiny-dot"></span> Illustrative workflow. The full
        experience is not being announced as available today.
      </p>
    </div>
  </section>
  <section class="section priorities-section">
    <div class="container editorial-grid">
      <div>
        <span class="eyebrow">ON THE WORKBENCH</span>
        <h2>
          What we’re
          <br />
          <span class="serif-accent">working toward.</span>
        </h2>
        <p class="body-copy">
          These are development priorities,
          <br />
          not a list of released features.
        </p>
      </div>
      <div class="priorities-list">
        {priorities.map(([icon, title, text]) => (
          <article data-reveal>
            <span class="priority-icon">
              <Icon name={icon} />
            </span>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
            <span class="priority-status mono">PLANNED</span>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section faq-section">
    <div class="container editorial-grid">
      <div>
        <span class="eyebrow">A FEW THINGS TO KNOW</span>
        <h2>
          Good
          <br />
          <span class="serif-accent">questions.</span>
        </h2>
      </div>
      <div class="faq-list">
        {faqs.map(([q, a]) => (
          <article data-reveal>
            <h3>{q}</h3>
            <p>{a}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <ContactBand
    title="Your workflow could shape what’s next."
    text="Tell us where work gets stuck. We’d like to understand the next step you wish AI could help with."
    label="Discuss a use case"
  />
</Layout>
