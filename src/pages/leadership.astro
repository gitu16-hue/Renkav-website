---
import Layout from '../layouts/Layout.astro';
import ContactBand from '../components/ContactBand.astro';
---

<Layout
  title="Leadership | RENKAV Technologies"
  description="Meet Gitanshu Damade and Yashika Pawar, the founders behind RENKAV Technologies."
>
  <section class="masthead dark-section">
    <div class="container">
      <span class="eyebrow entry">FOUNDING TEAM</span>
      <h1 class="entry entry-1">
        The founders
        <br />
        <span class="mint">behind RENKAV.</span>
      </h1>
      <p class="entry entry-2">
        RENKAV is being built by Gitanshu Damade and Yashika Pawar.
        <br class="desktop-break" /> Their first project is ELEVEN.
      </p>
      <span class="masthead-mark founders-mark" aria-hidden="true">
        / 02
      </span>
    </div>
  </section>
  <section class="section leadership-section">
    <div class="container">
      <div class="founders-full-grid">
        {[
          {
            name: 'Gitanshu Damade',
            role: 'Founder',
            initials: 'GD',
            id: 'gitanshu',
          },
          {
            name: 'Yashika Pawar',
            role: 'Co-founder',
            initials: 'YP',
            id: 'yashika',
          },
        ].map((founder, i) => (
          <article class="founder-card" id={founder.id} data-reveal>
            <div
              class:list={['founder-portrait', { second: i === 1 }]}
              aria-hidden="true"
            >
              <div class="portrait-rings">
                <i></i>
                <i></i>
                <i></i>
              </div>
              <span>{founder.initials}</span>
              <small>RENKAV / FOUNDING TEAM</small>
            </div>
            <div class="founder-details">
              <h2>{founder.name}</h2>
              <span class="founder-role">{founder.role}</span>
            </div>
          </article>
        ))}
      </div>
      <div class="leadership-note" data-reveal>
        <span class="eyebrow">A SHARED STARTING POINT</span>
        <p>
          Building a more connected way to work with AI.
          <br />
          <span class="muted">One thoughtful step at a time.</span>
        </p>
      </div>
    </div>
  </section>
  <ContactBand
    title="Have a question about what we’re building?"
    text="We’d like to hear from you."
    label="Contact RENKAV"
  />
</Layout>
